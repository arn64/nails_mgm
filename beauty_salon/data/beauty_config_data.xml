<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- WhatsApp del salón aki (con código país, solo dígitos).
         Se usa en el botón "Confirmar por WhatsApp" de la página de éxito.
         El envío automático además requiere beauty_salon.whatsapp_token
         y beauty_salon.whatsapp_phone_id (API de Meta). -->
    <record id="beauty_whatsapp_number_param" model="ir.config_parameter">
        <field name="key">beauty_salon.whatsapp_number</field>
        <field name="value">5354769627</field>
    </record>
</odoo>
