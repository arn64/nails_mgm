<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_beauty_form" model="ir.ui.view">
        <field name="name">res.partner.beauty.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <page name="sales_purchases" position="after">
                <page string="Belleza" name="beauty" groups="base.group_user">
                    <group>
                        <group string="Ficha de belleza">
                            <field name="allergies" placeholder="Ej.: alergia al látex, HEMA..."/>
                            <field name="beauty_preferences" placeholder="Formas, colores, estilos favoritos..."/>
                        </group>
                        <group string="Historial">
                            <field name="appointment_count" readonly="1"/>
                            <field name="beauty_last_visit" readonly="1"/>
                        </group>
                    </group>
                    <field name="appointment_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="start_datetime"/>
                            <field name="technician_id"/>
                            <field name="amount_total"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="action_beauty_clients" model="ir.actions.act_window">
        <field name="name">Clientas</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_company', '=', False)]</field>
        <field name="context">{'default_is_company': False}</field>
    </record>
</odoo>
